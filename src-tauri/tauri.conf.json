{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllCo",
  "version": "0.1.0",
  "identifier": "online.allco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGODk0OTk1Rjg4NEQxMTUKUldRVjBZVDRsVW1KNzJZc25yR2pUazB1bGhOalVCbWNScUhiNnZpV2ZxdlhIR2dKbEF3Z01NcEIK",
      "endpoints": [
        "https://github.com/5duardo/AllCo-Desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "AllCo",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
