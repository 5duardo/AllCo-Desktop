{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllCo",
  "version": "0.4.1",
  "identifier": "online.allco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGODk0OTk1Rjg4NEQxMTUKUldRVjBZVDRsVW1KNzJZc25yR2pUazB1bGhOalVCbWNScUhiNnZpV2ZxdlhIR2dKbEF3Z01NcEIK",
      "endpoints": [
        "https://github.com/5duardo/AllCo-Desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "AllCo",
        "width": 360,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "focus": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "AllCo",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "visible": false,
        "decorations": false,
        "minimizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
